# This project was developed with assistance from AI tools.
#
# Derived bootc image for NVIDIA Jetson AGX Thor
# Adds MicroShift, flightctl-agent, greenboot, and workload plumbing
# to the sidecar team's CentOS Stream 10 Thor image.
#
# Build: oc create -f tekton/03-pipelinerun.yaml
# Deploy: RHEM fleet spec declares the image; flightctl-agent applies it via bootc

ARG BASE_IMAGE=registry.gitlab.com/redhat/rhel/sst/orin-sidecar/nvidia-jetson-sidecar/rhel-stream10:a66617e5-thor

FROM ${BASE_IMAGE}

# --- OVS runtime dependencies (el9 OVS needs libs not in CS10 base) ---
# unbound-libs not in the base image repos — install from CentOS Stream 10 mirror
RUN rpm -ivh https://mirror.stream.centos.org/10-stream/BaseOS/aarch64/os/Packages/unbound-libs-1.25.1-1.el10.aarch64.rpm

# --- MicroShift repo (el9 mirror with full repodata) ---
RUN printf '[microshift-4.22]\nname=MicroShift 4.22\nbaseurl=https://mirror.openshift.com/pub/openshift-v4/aarch64/microshift/ocp/latest-4.22/el9/os\nenabled=1\ngpgcheck=0\nsslverify=1\n' > /etc/yum.repos.d/microshift-4.22.repo

# --- flightctl repo ---
RUN curl -fsSL -o /etc/yum.repos.d/flightctl.repo \
    https://rpm.flightctl.io/flightctl-epel10.repo

# --- Install everything in one transaction ---
# MicroShift core from the el9 mirror (nodeps for el9/el10 cross)
# flightctl-agent + greenboot from flightctl repo
# Skip microshift-networking (requires OVN/subscription packages)
RUN cd /tmp && \
    MS_BASE="https://mirror.openshift.com/pub/openshift-v4/aarch64/microshift/ocp/latest-4.22/el9/os/Packages" && \
    MS_A="${MS_BASE}/microshift-4.22.0~rc.5-202605271558.p0.g853f977.assembly.rc.5.el9__aarch64" && \
    MS_N="${MS_BASE}/microshift-4.22.0~rc.5-202605271558.p0.g853f977.assembly.rc.5.el9__noarch" && \
    curl -fsSLO "${MS_A}/microshift-4.22.0~rc.5-202605271558.p0.g853f977.assembly.rc.5.el9.aarch64.rpm" && \
    curl -fsSLO "${MS_N}/microshift-selinux-4.22.0~rc.5-202605271558.p0.g853f977.assembly.rc.5.el9.noarch.rpm" && \
    curl -fsSLO "${MS_N}/microshift-release-info-4.22.0~rc.5-202605271558.p0.g853f977.assembly.rc.5.el9.noarch.rpm" && \
    rpm -ivh --nodeps /tmp/microshift-*.rpm && \
    rm -f /tmp/microshift-*.rpm && \
    systemctl enable microshift.service

# --- greenboot (hard dependency of flightctl-agent >= ~1.1.x) ---
# Not available from the flightctl EPEL10 repo or CS10 AppStream repodata
# consumed elsewhere in this file (only `flightctl-greenboot`, a separate
# package, is there) -- install directly from the CentOS Stream 10
# AppStream mirror, same pattern as unbound-libs above. Required because
# pinning flightctl-agent below to a stable (non-RC) release reintroduces
# a hard `Requires: greenboot` that the previously-unpinned install (which
# silently resolved to the 1.3.0~rc1 pre-release, whose spec drops the
# hard dependency) never exercised. See DECISIONS.md D022.
RUN rpm -ivh https://mirror.stream.centos.org/10-stream/AppStream/aarch64/os/Packages/greenboot-0.16.3-0.el10.aarch64.rpm

# --- flightctl-agent ---
# Pinned to 1.2.0 (latest stable release) rather than left unversioned.
# An unpinned `dnf install` previously picked up 1.3.0~rc1 (a pre-release
# build) simply because it was the newest package in the repo at build
# time. 1.2.0 supersedes 1.1.3, which patches CVE-2026-32280,
# CVE-2026-33186 (gRPC), CVE-2026-33815, CVE-2026-39821, and a fix for the
# agent hanging in "updating" state when boot-complete.target exists
# without greenboot. See DECISIONS.md D022.
RUN dnf install -y --setopt=install_weak_deps=False \
        flightctl-agent-1.2.0-1.el10 \
    && dnf clean all \
    && systemctl enable flightctl-agent.service

# --- Mask flightctl's greenboot auto-configure service (D023) ---
# flightctl-configure-greenboot.service runs before every
# greenboot-healthcheck.service and unconditionally rewrites
# /etc/greenboot/greenboot.conf's DISABLED_HEALTHCHECKS, blanket-disabling
# any required.d script it doesn't recognize as core greenboot or its own
# (name-matches "*flightctl*"). It ships with no allowlist/config knob for
# device-owner-authored checks, so it silently re-disables our two custom
# checks (40_microshift_running.sh, 40_vllm_gpu.sh) on every single boot,
# regardless of greenboot.conf edits (those get overwritten before
# greenboot even runs). Masking it here (baked into the image, not a local
# /etc override that ostree could merge away) is the only way to keep our
# checks actually enforced. Trade-off: we lose flightctl's own gating of
# *other* unknown third-party checks too -- acceptable since these two are
# the only third-party checks this image ships, both reviewed and
# hardened with bounded retry loops. See DECISIONS.md D023.
RUN systemctl mask flightctl-configure-greenboot.service

# --- CRI-O 1.35, cri-tools, OVS 3.5, networking (from OCP deps mirror) ---
ARG OCP_DEPS=https://mirror.openshift.com/pub/openshift-v4/aarch64/dependencies/rpms/4.22-el9-beta
RUN cd /tmp && \
    curl -fsSLO "${OCP_DEPS}/cri-o-1.35.5-3.rhaos4.22.git0adf62b.el9.aarch64.rpm" && \
    curl -fsSLO "${OCP_DEPS}/cri-tools-1.35.0-2.el9.aarch64.rpm" && \
    curl -fsSLO "${OCP_DEPS}/openvswitch3.5-3.5.2-72.el9fdp.2.aarch64.rpm" && \
    curl -fsSLO "https://mirror.openshift.com/pub/openshift-v4/aarch64/microshift/ocp/latest-4.22/el9/os/Packages/microshift-4.22.0~rc.5-202605271558.p0.g853f977.assembly.rc.5.el9__aarch64/microshift-networking-4.22.0~rc.5-202605271558.p0.g853f977.assembly.rc.5.el9.aarch64.rpm" && \
    rpm -ivh --nodeps /tmp/cri-o-*.rpm /tmp/cri-tools-*.rpm /tmp/openvswitch3.5-*.rpm /tmp/microshift-networking-*.rpm && \
    rm -f /tmp/*.rpm && \
    systemctl enable crio.service openvswitch.service

# --- oc CLI ---
RUN curl -fsSL "https://mirror.openshift.com/pub/openshift-v4/aarch64/clients/ocp/stable-4.22/openshift-client-linux-arm64-rhel9-4.22.8.tar.gz" | \
    tar xzf - -C /usr/local/bin oc kubectl && \
    chmod +x /usr/local/bin/oc /usr/local/bin/kubectl

# --- GPU reset service (Thor GCx workaround — GPU needs module reload after boot) ---
COPY config/nvidia-gpu-reset.sh /usr/local/bin/nvidia-gpu-reset.sh
COPY config/nvidia-gpu-reset.service /usr/lib/systemd/system/nvidia-gpu-reset.service
RUN chmod +x /usr/local/bin/nvidia-gpu-reset.sh && systemctl enable nvidia-gpu-reset.service

# --- OpenTelemetry collector (RPM, runs as systemd service) ---
RUN rpm -ivh https://mirror.stream.centos.org/10-stream/AppStream/aarch64/os/Packages/opentelemetry-collector-0.152.1-1.el10.aarch64.rpm \
    && mkdir -p /var/lib/otel-queue \
    && systemctl enable opentelemetry-collector.service
COPY config/otel-collector.yaml /etc/opentelemetry-collector/config.yaml

# --- Mask bootc auto-update timer (RHEM owns OS updates) ---
RUN systemctl mask bootc-fetch-apply-updates.timer bootc-fetch-apply-updates.service

# --- Persistent directories for workload data (survive bootc switch) ---
RUN mkdir -p /var/lib/models /var/lib/episodes /var/lib/checkpoints \
    && chmod 775 /var/lib/models /var/lib/episodes /var/lib/checkpoints

# --- Greenboot health checks ---
COPY greenboot/40_microshift.sh /etc/greenboot/check/required.d/40_microshift_running.sh
COPY greenboot/40_vllm_gpu.sh /etc/greenboot/check/required.d/40_vllm_gpu.sh
RUN chmod +x /etc/greenboot/check/required.d/40_microshift_running.sh \
             /etc/greenboot/check/required.d/40_vllm_gpu.sh

# --- Sigstore trust anchor ---
# policy.json declares WHAT to require (sigstoreSigned for the internal
# registry); registries.d declares WHERE/WHETHER to look for the signature
# at all -- both are required for CRI-O and bootc pulls, or pulls silently
# skip signature lookup and fail with "no signature exists" even for
# validly-signed images. See DECISIONS.md D018/D019.
COPY config/policy.json /etc/containers/policy.json
COPY config/cosign-signing.pub /etc/pki/containers/cosign-signing.pub
COPY config/registries.d-internal-registry.yaml /etc/containers/registries.d/internal-registry.yaml

# --- MicroShift configuration ---
RUN mkdir -p /etc/microshift
COPY config/microshift-config.yaml /etc/microshift/config.yaml

# --- Day-0 manifest directory ---
RUN mkdir -p /etc/microshift/manifests
COPY manifests/ /etc/microshift/manifests/

# --- Embed workload container images for air-gapped operation ---
ENV IMAGE_STORAGE_DIR=/usr/lib/containers/storage
ENV IMAGE_LIST_FILE=${IMAGE_STORAGE_DIR}/image-list.txt
COPY config/embedded-images.txt /tmp/embedded-images.txt
RUN mkdir -p "${IMAGE_STORAGE_DIR}" && \
    while IFS= read -r img || [ -n "$img" ]; do \
        [ -z "$img" ] && continue; \
        [ "${img#\#}" != "$img" ] && continue; \
        sha="$(echo "${img}" | sha256sum | awk '{print $1}')" ; \
        skopeo copy --all --preserve-digests \
            "docker://${img}" "dir:${IMAGE_STORAGE_DIR}/${sha}" && \
        echo "${img},${sha}" >> "${IMAGE_LIST_FILE}" ; \
    done < /tmp/embedded-images.txt && \
    rm -f /tmp/embedded-images.txt

# --- Boot-time image loader (dir: -> containers-storage:) ---
COPY config/microshift-copy-images.sh /usr/bin/microshift-copy-images
RUN chmod 755 /usr/bin/microshift-copy-images && \
    mkdir -p /usr/lib/systemd/system/microshift.service.d
COPY config/microshift-copy-images.conf /usr/lib/systemd/system/microshift.service.d/microshift-copy-images.conf
